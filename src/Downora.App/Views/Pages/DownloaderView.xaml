<UserControl
    x:Class="Downora.App.Views.Pages.DownloaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:Downora.App.Localization"
    xmlns:controls="clr-namespace:Downora.App.Controls"
    xmlns:vm="clr-namespace:Downora.Presentation.ViewModels;assembly=Downora.Presentation"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:DownloaderViewModel}">

    <Grid Margin="{StaticResource Padding.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageHeader}" Text="{l:Loc Nav_Downloader}" />

        <!-- Link bar -->
        <Border Grid.Row="1" Margin="0,0,0,16" Padding="12" Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        AutomationProperties.Name="{l:Loc Home_UrlPlaceholder}"
                        FlowDirection="LeftToRight"
                        Icon="{ui:SymbolIcon Link24}"
                        PlaceholderText="{l:Loc Home_UrlPlaceholder}"
                        Text="{Binding UrlText, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AnalyzeCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <ui:Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding PasteCommand}" Content="{l:Loc Common_Paste}" Icon="{ui:SymbolIcon ClipboardPaste24}" />
                    <ui:Button Grid.Column="2" Margin="8,0,0,0" Appearance="Primary" Command="{Binding AnalyzeCommand}" Content="{l:Loc Common_Analyze}" Icon="{ui:SymbolIcon Search24}" />
                </Grid>
                <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Error}" Text="{Binding ValidationMessage}" Visibility="{Binding ValidationMessage, Converter={StaticResource HasValueToVisibility}}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Idle -->
                <controls:EmptyState
                    VerticalAlignment="Top"
                    Description="{Binding IdleBody}"
                    Icon="Link24"
                    Title="{l:Loc Downloader_EmptyTitle}"
                    Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                    <ui:Button Command="{Binding ChangeFolderCommand}" Content="{l:Loc Downloader_ChangeFolder}" Icon="{ui:SymbolIcon FolderOpen24}" />
                </controls:EmptyState>

                <!-- Analyzing -->
                <Border VerticalAlignment="Top" Padding="32" Style="{StaticResource Card}" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:ProgressRing Width="44" Height="44" HorizontalAlignment="Center" IsIndeterminate="True" />
                        <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.TitleMd}" Text="{l:Loc Downloader_Analyzing}" />
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Secondary}" Text="{l:Loc Downloader_AnalyzingHint}" />
                        <ui:Button Margin="0,16,0,0" HorizontalAlignment="Center" Command="{Binding CancelCommand}" Content="{l:Loc Common_Cancel}" Icon="{ui:SymbolIcon Dismiss24}" />
                    </StackPanel>
                </Border>

                <!-- Single video / track -->
                <Grid VerticalAlignment="Top" Visibility="{Binding IsMedia, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="6*" />
                    </Grid.ColumnDefinitions>

                    <Border VerticalAlignment="Top" Padding="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <Border CornerRadius="8,8,0,0" Style="{StaticResource Thumbnail}">
                                <Grid Height="220">
                                    <ui:SymbolIcon FontSize="36" Foreground="{DynamicResource Brush.TextTertiary}" Symbol="Video24" />
                                    <Image Source="{Binding ThumbnailUrl, Converter={StaticResource ThumbnailConverter}, ConverterParameter=640}" Stretch="UniformToFill" />
                                    <Border Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC000000" Style="{StaticResource Tag}">
                                        <TextBlock Foreground="White" Style="{StaticResource Tag.Text}" Text="{Binding PlatformLabel}" />
                                    </Border>
                                    <Border Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#CC000000" Style="{StaticResource Tag}" Visibility="{Binding DurationText, Converter={StaticResource HasValueToVisibility}}">
                                        <TextBlock FontFamily="{StaticResource Font.Mono}" Foreground="White" Style="{StaticResource Tag.Text}" Text="{Binding DurationText}" />
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Margin="16,14,16,16">
                                <TextBlock Style="{StaticResource Text.TitleLg}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="56" ToolTip="{Binding Title}" />
                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal" Visibility="{Binding Uploader, Converter={StaticResource HasValueToVisibility}}">
                                    <ui:SymbolIcon FontSize="14" Foreground="{DynamicResource Brush.TextSecondary}" Symbol="Person24" />
                                    <TextBlock Margin="6,0,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding Uploader}" />
                                </StackPanel>
                                <Border Margin="0,12,0,0" Background="{StaticResource Brush.Status.Processing.Bg}" BorderBrush="{StaticResource Brush.Status.Processing.Border}" Padding="10" Style="{StaticResource Card}" Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Text.Body}" Text="{l:Loc Downloader_Live}" TextTrimming="None" TextWrapping="Wrap" />
                                </Border>
                                <ui:Button Margin="0,14,0,0" Command="{Binding OpenInBrowserCommand}" Content="{l:Loc Downloader_OpenInBrowser}" Icon="{ui:SymbolIcon Globe24}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,10" Style="{StaticResource Text.TitleMd}" Text="{l:Loc Downloader_Qualities}" />
                            <ListBox
                                AutomationProperties.Name="{l:Loc Downloader_Qualities}"
                                ItemsSource="{Binding Qualities}"
                                SelectedItem="{Binding SelectedQuality, Mode=TwoWay}"
                                Style="{StaticResource OptionList}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:QualityOptionViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.BodyStrong}" Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{Binding Detail}" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Text.Metric}" Text="{Binding SizeText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ui:Button
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Appearance="Primary"
                                Command="{Binding DownloadVideoCommand}"
                                Content="{l:Loc Downloader_Download}"
                                Icon="{ui:SymbolIcon ArrowDownload24}" />

                            <!-- Audio only -->
                            <Border Margin="0,16,0,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Style="{StaticResource Text.TitleMd}" Text="{l:Loc Downloader_AudioTitle}" />
                                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.Metric}" Text="{Binding AudioOption.SizeText}" />
                                    </Grid>
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding BestAudioText}" TextWrapping="Wrap" Visibility="{Binding BestAudioText, Converter={StaticResource HasValueToVisibility}}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            AutomationProperties.Name="{l:Loc Downloader_AudioFormat}"
                                            DisplayMemberPath="Label"
                                            ItemsSource="{Binding AudioFormats}"
                                            SelectedItem="{Binding SelectedAudioFormat, Mode=TwoWay}" />
                                        <ui:Button
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Command="{Binding DownloadAudioCommand}"
                                            Content="{l:Loc Downloader_DownloadAudio}"
                                            Icon="{ui:SymbolIcon MusicNote224}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Where it goes -->
                            <Border Margin="0,16,0,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{Binding SavedToText}" TextWrapping="Wrap" />
                                    <ui:Button Grid.Column="1" Margin="8,0,0,0" Appearance="Transparent" Command="{Binding ChangeFolderCommand}" Content="{l:Loc Downloader_ChangeFolder}" />
                                </Grid>
                            </Border>

                            <!-- The download just started from here, followed live -->
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding HasStartedDownload, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Margin="0,0,0,8" Style="{StaticResource Text.BodyStrong}" Text="{Binding StartedMessage}" />
                                <ContentPresenter Content="{Binding StartedDownload}" ContentTemplate="{StaticResource DownloadCard}" />
                                <ui:Button
                                    Appearance="Primary"
                                    Command="{Binding OpenSignInSettingsCommand}"
                                    Content="{l:Loc Downloader_UseBrowserSignIn}"
                                    Icon="{ui:SymbolIcon Person24}"
                                    Visibility="{Binding ShowStartedSignInAction, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Error}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Playlist -->
                <StackPanel VerticalAlignment="Top" Visibility="{Binding IsPlaylist, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="160" Height="90" Style="{StaticResource Thumbnail}">
                                <Grid>
                                    <ui:SymbolIcon FontSize="28" Foreground="{DynamicResource Brush.TextTertiary}" Symbol="TextBulletListLtr24" />
                                    <Image Source="{Binding ThumbnailUrl, Converter={StaticResource ThumbnailConverter}, ConverterParameter=320}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource Tag}">
                                        <TextBlock Style="{StaticResource Tag.Text}" Text="{Binding PlatformLabel}" />
                                    </Border>
                                    <Border Margin="4,0,0,0" Style="{StaticResource Tag}">
                                        <TextBlock Style="{StaticResource Tag.Text}" Text="{l:Loc Downloader_Playlist}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.TitleLg}" Text="{Binding Title}" ToolTip="{Binding Title}" />
                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Uploader}" Visibility="{Binding Uploader, Converter={StaticResource HasValueToVisibility}}" />
                                    <TextBlock Margin="12,0,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding PlaylistCountText}" />
                                    <TextBlock Margin="12,0,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding PlaylistDurationText}" Visibility="{Binding PlaylistDurationText, Converter={StaticResource HasValueToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                            <ui:Button Grid.Column="2" VerticalAlignment="Center" Command="{Binding OpenInBrowserCommand}" Content="{l:Loc Downloader_OpenInBrowser}" Icon="{ui:SymbolIcon Globe24}" />
                        </Grid>
                    </Border>
                    <Border Margin="0,12,0,0" Padding="0" Style="{StaticResource Card}">
                        <ItemsControl ItemsSource="{Binding Entries}" VirtualizingPanel.IsVirtualizing="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PlaylistEntryViewModel}">
                                    <Border x:Name="Row" Padding="16,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="72" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Metric}" Text="{Binding Index}" />
                                            <Border Grid.Column="1" Width="64" Height="36" Style="{StaticResource Thumbnail}">
                                                <Grid>
                                                    <ui:SymbolIcon FontSize="14" Foreground="{DynamicResource Brush.TextTertiary}" Symbol="Video24" />
                                                    <Image Source="{Binding ThumbnailUrl, Converter={StaticResource ThumbnailConverter}, ConverterParameter=128}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Title}" ToolTip="{Binding Title}" />
                                                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Uploader}" Visibility="{Binding Uploader, Converter={StaticResource HasValueToVisibility}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Status.Failed.Fg}" Style="{StaticResource Text.Caption}" Text="{Binding StatusText}" />
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource Text.Metric}" Text="{Binding DurationText}" TextAlignment="Right" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                            <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- Failure -->
                <Border VerticalAlignment="Top" Padding="24" Style="{StaticResource Card}" Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" VerticalAlignment="Top" Background="{StaticResource Brush.Status.Failed.Bg}" CornerRadius="22">
                            <ui:SymbolIcon FontSize="22" Foreground="{DynamicResource Brush.Status.Failed.Fg}" Symbol="ErrorCircle24" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Style="{StaticResource Text.TitleMd}" Text="{Binding ErrorTitle}" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding ErrorBody}" TextTrimming="None" TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left" Style="{StaticResource Text.Metric}" Text="{Binding ErrorDetail}" TextWrapping="Wrap" Visibility="{Binding ErrorDetail, Converter={StaticResource HasValueToVisibility}}" />
                            <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                <ui:Button
                                    Appearance="Primary"
                                    Command="{Binding InstallToolsCommand}"
                                    Content="{l:Loc Downloader_InstallTools}"
                                    Icon="{ui:SymbolIcon ArrowDownload24}"
                                    Visibility="{Binding CanInstallTools, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button
                                    Appearance="Primary"
                                    Command="{Binding OpenSignInSettingsCommand}"
                                    Content="{l:Loc Downloader_UseBrowserSignIn}"
                                    Icon="{ui:SymbolIcon Person24}"
                                    Visibility="{Binding CanUseBrowserSignIn, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button
                                    Appearance="Primary"
                                    Command="{Binding OpenSignInSettingsCommand}"
                                    Content="{l:Loc Downloader_OpenSignInSettings}"
                                    Icon="{ui:SymbolIcon Settings24}"
                                    Visibility="{Binding CanOpenSignInSettings, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button
                                    Margin="8,0,0,0"
                                    Command="{Binding RetryCommand}"
                                    Content="{l:Loc Common_TryAgain}"
                                    Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                                    Visibility="{Binding CanInstallTools, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Caption}" Text="{l:Loc Downloader_SignInHint}" TextWrapping="Wrap" Visibility="{Binding CanUseBrowserSignIn, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding InstallStatus}" TextWrapping="Wrap" Visibility="{Binding InstallStatus, Converter={StaticResource HasValueToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
