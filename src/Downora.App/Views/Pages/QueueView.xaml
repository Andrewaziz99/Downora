<UserControl
    x:Class="Downora.App.Views.Pages.QueueView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:l="clr-namespace:Downora.App.Localization"
    xmlns:controls="clr-namespace:Downora.App.Controls"
    xmlns:vm="clr-namespace:Downora.Presentation.ViewModels;assembly=Downora.Presentation"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:QueueViewModel}">

    <Grid Margin="{StaticResource Padding.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageHeader}" Text="{l:Loc Nav_Queue}" />

        <Border Grid.Row="1" Margin="0,0,0,16" Padding="8" Style="{StaticResource Card}">
            <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" Style="{StaticResource TabStrip}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Text="{Binding Label}" />
                            <Border Style="{StaticResource CountBadge}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Badge}" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Count}" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="2" Margin="0,0,0,12" Style="{StaticResource Text.Error}" Text="{Binding ErrorMessage}" Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />

        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemTemplate="{StaticResource DownloadCard}" ItemsSource="{Binding Items}" />
            </ScrollViewer>
            <controls:EmptyState
                VerticalAlignment="Top"
                Description="{l:Loc Queue_EmptyBody}"
                Icon="TextBulletListLtr24"
                Title="{l:Loc Queue_EmptyTitle}"
                Visibility="{Binding IsQueueEmpty, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock
                VerticalAlignment="Top"
                Style="{StaticResource Text.Secondary}"
                Text="{l:Loc Queue_FilterEmpty}"
                Visibility="{Binding IsFilterEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</UserControl>
