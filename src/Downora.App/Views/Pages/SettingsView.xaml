<UserControl
    x:Class="Downora.App.Views.Pages.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:Downora.App.Localization"
    xmlns:vm="clr-namespace:Downora.Presentation.ViewModels;assembly=Downora.Presentation"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" Margin="{StaticResource Padding.Page}" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageHeader}" Text="{l:Loc Nav_Settings}" />
            <TextBlock Margin="0,0,0,12" Style="{StaticResource Text.Error}" Text="{Binding ErrorMessage}" Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />

            <!-- Appearance -->
            <TextBlock Margin="0,0,0,8" Style="{StaticResource Text.BodyStrong}" Text="{l:Loc Settings_Appearance}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DarkTheme24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}" Text="{l:Loc Settings_Theme}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_ThemeDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox
                    MinWidth="200"
                    AutomationProperties.Name="{l:Loc Settings_Theme}"
                    DisplayMemberPath="Label"
                    ItemsSource="{Binding ThemeOptions}"
                    SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Translate24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}" Text="{l:Loc Settings_Language}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_LanguageDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox
                    MinWidth="200"
                    AutomationProperties.Name="{l:Loc Settings_Language}"
                    DisplayMemberPath="Label"
                    ItemsSource="{Binding LanguageOptions}"
                    SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
            </ui:CardControl>

            <!-- Downloads -->
            <TextBlock Margin="0,20,0,8" Style="{StaticResource Text.BodyStrong}" Text="{l:Loc Settings_Downloads}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon FolderOpen24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}" Text="{l:Loc Settings_Folder}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding DownloadDirectoryDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DownloadDirectoryDisplay}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Command="{Binding OpenDownloadFolderCommand}" Content="{l:Loc Common_Open}" />
                    <ui:Button Margin="8,0,0,0" Appearance="Primary" Command="{Binding BrowseFolderCommand}" Content="{l:Loc Settings_Browse}" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowSync24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}" Text="{l:Loc Settings_Concurrent}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_ConcurrentDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox
                    MinWidth="120"
                    AutomationProperties.Name="{l:Loc Settings_Concurrent}"
                    ItemsSource="{Binding ConcurrencyChoices}"
                    SelectedItem="{Binding MaxConcurrentDownloads, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Play24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}" Text="{l:Loc Settings_AutoStart}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_AutoStartDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch
                    AutomationProperties.Name="{l:Loc Settings_AutoStart}"
                    IsChecked="{Binding AutoStartDownloads, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Tag24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}" Text="{l:Loc Settings_EmbedMetadata}" />
                        <TextBlock MaxWidth="560" HorizontalAlignment="Left" Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_EmbedMetadataDesc}" TextTrimming="None" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch
                    AutomationProperties.Name="{l:Loc Settings_EmbedMetadata}"
                    IsChecked="{Binding EmbedMetadata, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Image24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}" Text="{l:Loc Settings_EmbedCover}" />
                        <TextBlock MaxWidth="560" HorizontalAlignment="Left" Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_EmbedCoverDesc}" TextTrimming="None" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch
                    AutomationProperties.Name="{l:Loc Settings_EmbedCover}"
                    IsChecked="{Binding EmbedCoverArt, Mode=TwoWay}" />
            </ui:CardControl>

            <!-- Browser sign-in (opt-in) -->
            <StackPanel x:Name="CookieSection">
                <TextBlock Margin="0,20,0,8" Style="{StaticResource Text.BodyStrong}" Text="{l:Loc Settings_Cookies}" />
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Person24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Text="{l:Loc Settings_CookiesUse}" />
                            <TextBlock MaxWidth="560" HorizontalAlignment="Left" Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_CookiesDesc}" TextTrimming="None" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch
                        x:Name="CookieToggle"
                        AutomationProperties.Name="{l:Loc Settings_CookiesUse}"
                        IsChecked="{Binding UseBrowserSession, Mode=TwoWay}" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Globe24}" IsEnabled="{Binding UseBrowserSession}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Text="{l:Loc Settings_CookiesBrowser}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_CookiesBrowserDesc}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox
                        MinWidth="200"
                        AutomationProperties.Name="{l:Loc Settings_CookiesBrowser}"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding BrowserOptions}"
                        SelectedItem="{Binding SelectedBrowser, Mode=TwoWay}" />
                </ui:CardControl>
            </StackPanel>

            <!-- Data -->
            <TextBlock Margin="0,20,0,8" Style="{StaticResource Text.BodyStrong}" Text="{l:Loc Settings_Data}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Database24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}" Text="{l:Loc Settings_DataFolder}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding DataDirectoryDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DataDirectoryDisplay}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Command="{Binding OpenDataFolderCommand}" Content="{l:Loc Common_Open}" />
            </ui:CardControl>

            <!-- Tools -->
            <TextBlock Margin="0,20,0,8" Style="{StaticResource Text.BodyStrong}" Text="{l:Loc Settings_Tools}" />
            <ItemsControl ItemsSource="{Binding ToolRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ToolRowViewModel}">
                        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Wrench24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Title}" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Description}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" Text="{Binding StatusText}" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Error}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:ProgressRing Width="20" Height="20" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button Appearance="Primary" Command="{Binding InstallCommand}" Content="{l:Loc Tool_Install}" Icon="{ui:SymbolIcon ArrowDownload24}" Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button Command="{Binding UpdateCommand}" Content="{l:Loc Tool_Update}" Icon="{ui:SymbolIcon ArrowSync24}" Visibility="{Binding ShowUpdate, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
