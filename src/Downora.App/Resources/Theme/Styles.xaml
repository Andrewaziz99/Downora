<!-- Component styles for the Fluent Velocity design system. Theme colors are DynamicResource so Dark/Light switch live. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Downora.App.Controls"
    xmlns:conv="clr-namespace:Downora.App.Converters">

    <!-- Merged here (not only in App.xaml) so StaticResource lookups below resolve while this file loads. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Downora;component/Resources/Theme/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <conv:ThumbnailConverter x:Key="ThumbnailConverter" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:HasValueToVisibilityConverter x:Key="HasValueToVisibility" />
    <conv:SymbolConverter x:Key="SymbolConverter" />
    <conv:MediaGlyphConverter x:Key="MediaGlyphConverter" />
    <conv:CountToVisibilityConverter x:Key="CountToVisibility" />

    <!-- Focus ring: WPF shows FocusVisualStyle only for keyboard navigation, never after a mouse click. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-1" RadiusX="5" RadiusY="5" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text -->
    <Style x:Key="Text.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Text.TitleLg" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.TitleLg}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.TitleMd" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.TitleMd}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Text.Metric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.Error" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Failed.Fg}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
    </Style>
    <Style x:Key="Card.Hover" TargetType="Border" BasedOn="{StaticResource Card}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
                <Setter Property="BorderBrush" Value="#4D00C2B8" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Thumbnail" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- Badge for file type / quality (MP4, 1080p) -->
    <Style x:Key="Tag" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.ControlFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Tag.Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Badge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <!-- Linear progress: 4 px rounded track, gradient fill; indeterminate pulses (Extracting / Processing). -->
    <Style x:Key="GradientProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{DynamicResource Brush.Track}" CornerRadius="2" />
                        <Border
                            x:Name="PART_Indicator"
                            HorizontalAlignment="Left"
                            Background="{StaticResource Brush.ProgressGradient}"
                            CornerRadius="2" />
                        <Border
                            x:Name="Pulse"
                            Background="{StaticResource Brush.ProgressGradient}"
                            CornerRadius="2"
                            Opacity="0.35"
                            Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Pulse" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PulseStoryboard">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation
                                            Storyboard.TargetName="Pulse"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0.25"
                                            To="0.9"
                                            Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status pill -->
    <Style TargetType="controls:StatusPill">
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Badge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{StaticResource Brush.Status.Waiting.Bg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Waiting.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Waiting.Fg}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:StatusPill">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Pill}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" />
                            <TextBlock VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Text}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Status" Value="Extracting">
                <Setter Property="Background" Value="{StaticResource Brush.Status.Extracting.Bg}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Extracting.Border}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Extracting.Fg}" />
            </Trigger>
            <Trigger Property="Status" Value="Downloading">
                <Setter Property="Background" Value="{StaticResource Brush.Status.Downloading.Bg}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Downloading.Border}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Downloading.Fg}" />
            </Trigger>
            <Trigger Property="Status" Value="Processing">
                <Setter Property="Background" Value="{StaticResource Brush.Status.Processing.Bg}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Processing.Border}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Processing.Fg}" />
            </Trigger>
            <Trigger Property="Status" Value="Completed">
                <Setter Property="Background" Value="{StaticResource Brush.Status.Completed.Bg}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Completed.Border}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Completed.Fg}" />
            </Trigger>
            <Trigger Property="Status" Value="Failed">
                <Setter Property="Background" Value="{StaticResource Brush.Status.Failed.Bg}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Failed.Border}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Failed.Fg}" />
            </Trigger>
            <Trigger Property="Status" Value="Paused">
                <Setter Property="Background" Value="{StaticResource Brush.Status.Paused.Bg}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Paused.Border}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Paused.Fg}" />
            </Trigger>
            <Trigger Property="Status" Value="Cancelled">
                <Setter Property="Background" Value="{StaticResource Brush.Status.Cancelled.Bg}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Cancelled.Border}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Cancelled.Fg}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Empty state -->
    <Style TargetType="controls:EmptyState">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:EmptyState">
                    <Border Padding="32,40" Style="{StaticResource Card}">
                        <StackPanel MaxWidth="460" HorizontalAlignment="Center">
                            <Border
                                Width="56"
                                Height="56"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource Brush.ControlFill}"
                                CornerRadius="28">
                                <ui:SymbolIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="26"
                                    Foreground="{DynamicResource Brush.AccentText}"
                                    Symbol="{TemplateBinding Icon}" />
                            </Border>
                            <TextBlock
                                Margin="0,16,0,0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource Text.TitleMd}"
                                Text="{TemplateBinding Title}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                FontSize="{StaticResource FontSize.Body}"
                                Text="{TemplateBinding Description}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <ContentPresenter Margin="0,16,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Stat card -->
    <Style TargetType="controls:StatCard">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:StatCard">
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{TemplateBinding Label}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Style="{StaticResource Text.Display}"
                                    Text="{TemplateBinding Value}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Foreground="{DynamicResource Brush.AccentText}"
                                    Style="{StaticResource Text.Caption}"
                                    Text="{TemplateBinding Hint}" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Width="40"
                                Height="40"
                                VerticalAlignment="Top"
                                Background="{DynamicResource Brush.ControlFill}"
                                CornerRadius="6">
                                <ui:SymbolIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Foreground="{DynamicResource Brush.AccentText}"
                                    Symbol="{TemplateBinding Icon}" />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar entry: 36 px row, accent pill on the leading edge when selected (mirrors automatically in RTL). -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="GroupName" Value="Navigation" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="{StaticResource Radius.Control}">
                        <Grid>
                            <Rectangle
                                x:Name="Indicator"
                                Width="3"
                                Height="16"
                                HorizontalAlignment="Left"
                                Fill="{StaticResource Brush.Accent}"
                                RadiusX="1.5"
                                RadiusY="1.5"
                                Visibility="Collapsed" />
                            <ContentPresenter Margin="12,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.NavHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.NavSelected}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Horizontal tab strip bound to a selected option (queue filters, library kinds) -->
    <Style x:Key="TabStrip" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Margin" Value="0,0,4,0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Root" Padding="12,0" Background="Transparent" CornerRadius="{StaticResource Radius.Control}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.NavHover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.NavSelected}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Count bubble on tabs and the sidebar -->
    <Style x:Key="CountBadge" TargetType="Border">
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="{DynamicResource Brush.ControlFill}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Page header -->
    <Style x:Key="PageHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Display}">
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.TitleMd}">
        <Setter Property="Margin" Value="0,24,0,12" />
    </Style>
</ResourceDictionary>
