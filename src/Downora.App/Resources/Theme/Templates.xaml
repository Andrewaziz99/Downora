<!-- Item templates shared by several pages. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:Downora.App.Localization"
    xmlns:controls="clr-namespace:Downora.App.Controls"
    xmlns:vm="clr-namespace:Downora.Presentation.ViewModels;assembly=Downora.Presentation">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Downora;component/Resources/Theme/Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 16:9 thumbnail with a media glyph when there is no image. -->
    <DataTemplate x:Key="DownloadThumbnail" DataType="{x:Type vm:DownloadItemViewModel}">
        <Border Width="96" Height="54" Style="{StaticResource Thumbnail}">
            <Grid>
                <ui:SymbolIcon FontSize="20" Foreground="{DynamicResource Brush.TextTertiary}" Symbol="ArrowDownload24" />
                <Image Source="{Binding ThumbnailUrl, Converter={StaticResource ThumbnailConverter}, ConverterParameter=192}" Stretch="UniformToFill" />
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Queue card: thumbnail, title + format tags, progress, live numbers, status and actions. -->
    <DataTemplate x:Key="DownloadCard" DataType="{x:Type vm:DownloadItemViewModel}">
        <Border Margin="0,0,0,8" Padding="12" Style="{StaticResource Card.Hover}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter VerticalAlignment="Top" Content="{Binding}" ContentTemplate="{StaticResource DownloadThumbnail}" />
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock MaxWidth="460" Style="{StaticResource Text.BodyStrong}" Text="{Binding Title}" ToolTip="{Binding Title}" />
                        <Border Margin="8,0,0,0" Style="{StaticResource Tag}">
                            <TextBlock Style="{StaticResource Tag.Text}" Text="{Binding FileType}" />
                        </Border>
                        <Border Margin="4,0,0,0" Style="{StaticResource Tag}">
                            <TextBlock Style="{StaticResource Tag.Text}" Text="{Binding Quality}" />
                        </Border>
                    </StackPanel>
                    <ProgressBar
                        Margin="0,10,0,8"
                        IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                        Style="{StaticResource GradientProgress}"
                        Value="{Binding Progress, Mode=OneWay}" />
                    <WrapPanel>
                        <TextBlock Margin="0,0,16,0" Style="{StaticResource Text.Metric}" Text="{Binding SizeText}" Visibility="{Binding SizeText, Converter={StaticResource HasValueToVisibility}}" />
                        <TextBlock Margin="0,0,16,0" Style="{StaticResource Text.Metric}" Text="{Binding SpeedText}" Visibility="{Binding SpeedText, Converter={StaticResource HasValueToVisibility}}" />
                        <TextBlock Margin="0,0,16,0" Style="{StaticResource Text.Metric}" Text="{Binding EtaText}" Visibility="{Binding EtaText, Converter={StaticResource HasValueToVisibility}}" />
                        <TextBlock Margin="0,0,16,0" Style="{StaticResource Text.Metric}" Text="{Binding StageText}" Visibility="{Binding StageText, Converter={StaticResource HasValueToVisibility}}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Text.Error}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <controls:StatusPill HorizontalAlignment="Right" Status="{Binding Status}" Text="{Binding StatusLabel}" />
                    <StackPanel Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,4,0"
                            Appearance="Transparent"
                            AutomationProperties.Name="{l:Loc Queue_ShowFile}"
                            Command="{Binding ShowFileCommand}"
                            Icon="{ui:SymbolIcon DocumentArrowRight24}"
                            ToolTip="{l:Loc Queue_ShowFile}"
                            Visibility="{Binding HasOutputFile, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button
                            Margin="0,0,4,0"
                            Appearance="Transparent"
                            AutomationProperties.Name="{l:Loc Queue_OpenFolder}"
                            Command="{Binding OpenFolderCommand}"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            ToolTip="{l:Loc Queue_OpenFolder}" />
                        <ui:Button
                            Margin="0,0,4,0"
                            Appearance="Transparent"
                            AutomationProperties.Name="{l:Loc Queue_Pause}"
                            Command="{Binding PauseCommand}"
                            Icon="{ui:SymbolIcon Pause24}"
                            ToolTip="{l:Loc Queue_Pause}"
                            Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button
                            Margin="0,0,4,0"
                            Appearance="Transparent"
                            AutomationProperties.Name="{l:Loc Queue_Resume}"
                            Command="{Binding ResumeCommand}"
                            Icon="{ui:SymbolIcon Play24}"
                            ToolTip="{l:Loc Queue_Resume}"
                            Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button
                            Margin="0,0,4,0"
                            Appearance="Transparent"
                            AutomationProperties.Name="{l:Loc Queue_Retry}"
                            Command="{Binding RetryCommand}"
                            Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                            ToolTip="{l:Loc Queue_Retry}"
                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button
                            Appearance="Transparent"
                            AutomationProperties.Name="{l:Loc Common_Cancel}"
                            Command="{Binding CancelCommand}"
                            Icon="{ui:SymbolIcon Dismiss24}"
                            ToolTip="{l:Loc Common_Cancel}"
                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Home "recently completed" tile. -->
    <DataTemplate x:Key="RecentTile" DataType="{x:Type vm:DownloadItemViewModel}">
        <Border Margin="0,0,12,0" Padding="0" Style="{StaticResource Card.Hover}">
            <StackPanel>
                <Border Height="124" CornerRadius="8,8,0,0" Style="{StaticResource Thumbnail}">
                    <Grid>
                        <ui:SymbolIcon FontSize="28" Foreground="{DynamicResource Brush.TextTertiary}" Symbol="CheckmarkCircle24" />
                        <Image Source="{Binding ThumbnailUrl, Converter={StaticResource ThumbnailConverter}, ConverterParameter=320}" Stretch="UniformToFill" />
                        <Border Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#B3000000" Style="{StaticResource Tag}">
                            <TextBlock Foreground="White" Style="{StaticResource Tag.Text}" Text="{Binding FileType}" />
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Margin="12,10,12,12">
                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Title}" ToolTip="{Binding Title}" />
                    <Grid Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Quality}" />
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.Caption}" Text="{Binding FinishedText}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
