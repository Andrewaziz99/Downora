<!-- Generated from the Fluent Velocity palette; keep keys identical in Palette.Dark.xaml and Palette.Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Canvas">#FFF3F3F5</Color>
    <Color x:Key="Color.Sidebar">#FFEBEBEF</Color>
    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Color.SurfaceRaised">#FFF8F8FA</Color>
    <Color x:Key="Color.SurfaceHover">#FFEDEDF1</Color>
    <Color x:Key="Color.Border">#FFE5E5EA</Color>
    <Color x:Key="Color.BorderSubtle">#0A000000</Color>
    <Color x:Key="Color.BorderStrong">#1F000000</Color>
    <Color x:Key="Color.TextPrimary">#FF1C1C1E</Color>
    <Color x:Key="Color.TextSecondary">#FF636366</Color>
    <Color x:Key="Color.TextTertiary">#FF6E6E73</Color>
    <Color x:Key="Color.NavSelected">#0F000000</Color>
    <Color x:Key="Color.NavHover">#08000000</Color>
    <Color x:Key="Color.Track">#14000000</Color>
    <Color x:Key="Color.ControlFill">#0A000000</Color>
    <Color x:Key="Color.InputFill">#FFFFFFFF</Color>
    <Color x:Key="Color.AccentText">#FF00756F</Color>
    <Color x:Key="Color.Status.Waiting.Fg">#FF475569</Color>
    <Color x:Key="Color.Status.Extracting.Fg">#FF7E22CE</Color>
    <Color x:Key="Color.Status.Downloading.Fg">#FF0F766E</Color>
    <Color x:Key="Color.Status.Processing.Fg">#FFB45309</Color>
    <Color x:Key="Color.Status.Completed.Fg">#FF047857</Color>
    <Color x:Key="Color.Status.Failed.Fg">#FFB91C1C</Color>
    <Color x:Key="Color.Status.Paused.Fg">#FF475569</Color>
    <Color x:Key="Color.Status.Cancelled.Fg">#FF6E6E73</Color>
    <SolidColorBrush x:Key="Brush.Canvas" Color="{StaticResource Color.Canvas}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{StaticResource Color.BorderSubtle}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" />
    <SolidColorBrush x:Key="Brush.NavSelected" Color="{StaticResource Color.NavSelected}" />
    <SolidColorBrush x:Key="Brush.NavHover" Color="{StaticResource Color.NavHover}" />
    <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource Color.Track}" />
    <SolidColorBrush x:Key="Brush.ControlFill" Color="{StaticResource Color.ControlFill}" />
    <SolidColorBrush x:Key="Brush.InputFill" Color="{StaticResource Color.InputFill}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.Status.Waiting.Fg" Color="{StaticResource Color.Status.Waiting.Fg}" />
    <SolidColorBrush x:Key="Brush.Status.Extracting.Fg" Color="{StaticResource Color.Status.Extracting.Fg}" />
    <SolidColorBrush x:Key="Brush.Status.Downloading.Fg" Color="{StaticResource Color.Status.Downloading.Fg}" />
    <SolidColorBrush x:Key="Brush.Status.Processing.Fg" Color="{StaticResource Color.Status.Processing.Fg}" />
    <SolidColorBrush x:Key="Brush.Status.Completed.Fg" Color="{StaticResource Color.Status.Completed.Fg}" />
    <SolidColorBrush x:Key="Brush.Status.Failed.Fg" Color="{StaticResource Color.Status.Failed.Fg}" />
    <SolidColorBrush x:Key="Brush.Status.Paused.Fg" Color="{StaticResource Color.Status.Paused.Fg}" />
    <SolidColorBrush x:Key="Brush.Status.Cancelled.Fg" Color="{StaticResource Color.Status.Cancelled.Fg}" />
</ResourceDictionary>
