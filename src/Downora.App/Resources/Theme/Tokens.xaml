<!--
    Fluent Velocity design tokens that are the same in dark and light mode.
    Theme-dependent colors live in Palette.Dark.xaml / Palette.Light.xaml and are used with DynamicResource.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Brand -->
    <Color x:Key="Color.Accent">#FF00C2B8</Color>
    <Color x:Key="Color.Accent2">#FF2D7BFF</Color>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent2" Color="{StaticResource Color.Accent2}" />
    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource Color.Accent}" />
        <GradientStop Offset="1" Color="{StaticResource Color.Accent2}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ProgressGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource Color.Accent}" />
        <GradientStop Offset="1" Color="{StaticResource Color.Accent2}" />
    </LinearGradientBrush>

    <!-- Status: tinted fills and keylines work on both themes; text colors are in the palettes. -->
    <SolidColorBrush x:Key="Brush.Status.Waiting.Bg" Color="#2664748B" />
    <SolidColorBrush x:Key="Brush.Status.Waiting.Border" Color="#4064748B" />
    <SolidColorBrush x:Key="Brush.Status.Extracting.Bg" Color="#26A855F7" />
    <SolidColorBrush x:Key="Brush.Status.Extracting.Border" Color="#4DA855F7" />
    <SolidColorBrush x:Key="Brush.Status.Downloading.Bg" Color="#2600C2B8" />
    <SolidColorBrush x:Key="Brush.Status.Downloading.Border" Color="#4D00C2B8" />
    <SolidColorBrush x:Key="Brush.Status.Processing.Bg" Color="#26F59E0B" />
    <SolidColorBrush x:Key="Brush.Status.Processing.Border" Color="#4DF59E0B" />
    <SolidColorBrush x:Key="Brush.Status.Completed.Bg" Color="#2610B981" />
    <SolidColorBrush x:Key="Brush.Status.Completed.Border" Color="#4D10B981" />
    <SolidColorBrush x:Key="Brush.Status.Failed.Bg" Color="#26EF4444" />
    <SolidColorBrush x:Key="Brush.Status.Failed.Border" Color="#4DEF4444" />
    <SolidColorBrush x:Key="Brush.Status.Paused.Bg" Color="#1F94A3B8" />
    <SolidColorBrush x:Key="Brush.Status.Paused.Border" Color="#3394A3B8" />
    <SolidColorBrush x:Key="Brush.Status.Cancelled.Bg" Color="#1A8E8E93" />
    <SolidColorBrush x:Key="Brush.Status.Cancelled.Border" Color="#338E8E93" />

    <!-- Typography -->
    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="FontSize.Display">28</sys:Double>
    <sys:Double x:Key="FontSize.TitleLg">20</sys:Double>
    <sys:Double x:Key="FontSize.TitleMd">16</sys:Double>
    <sys:Double x:Key="FontSize.BodyLg">14</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Badge">11</sys:Double>

    <!-- Shape and spacing (8 pt grid) -->
    <CornerRadius x:Key="Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">10</CornerRadius>
    <Thickness x:Key="Padding.Page">24,16,24,24</Thickness>
    <Thickness x:Key="Padding.Card">16</Thickness>
    <sys:Double x:Key="Width.Sidebar">240</sys:Double>
</ResourceDictionary>
