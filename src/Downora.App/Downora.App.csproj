<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Downora.App</RootNamespace>
    <AssemblyName>Downora</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\downora.ico</ApplicationIcon>
    <!-- Only for the tray icon (System.Windows.Forms.NotifyIcon); the UI is WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF reads its DPI mode from app.manifest; WinForms' advice to configure it in code does not apply here. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keeps WinForms' type names (Application, MessageBox, Clipboard...) from clashing with WPF's. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Downora.Core\Downora.Core.csproj" />
    <ProjectReference Include="..\Downora.Infrastructure\Downora.Infrastructure.csproj" />
    <ProjectReference Include="..\Downora.Presentation\Downora.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\downora.ico" />
    <Resource Include="Assets\downora-256.png" />
    <None Remove="Assets\downora-icon.svg" />
  </ItemGroup>

</Project>
